<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). The UI itself is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PowerModeSwitcher</AssemblyName>
    <RootNamespace>PowerModeSwitcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\knob-balanced-sailboat.ico</ApplicationIcon>
    <!-- Release builds from GitHub override this with the tag (v1.2.3 -> 1.2.3). -->
    <Version>1.0.0</Version>
    <Product>Power Mode Switcher</Product>
    <Description>Switches the Windows 11 Power Mode with a desktop slider.</Description>
    <!-- WFO0003 asks Windows Forms apps to set DPI awareness in code. This is a WPF app,
         which takes it from app.manifest, so the manifest setting is correct here. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- The app is English only. Leaves out the framework's translated resource files, which saves
         about 6 MB in the standalone (self-contained) .exe. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Needed by CsWin32's generated declarations and by [LibraryImport]. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- JSON must go through the source-generated AppJsonContext. This makes any reflection-based
         JsonSerializer call fail immediately instead of silently working. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- CsWin32 generates the documented Win32 declarations listed in Native\NativeMethods.txt
         at build time (build-time only; nothing is added to the published app). -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
    <AdditionalFiles Include="Native\NativeMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep Windows Forms names out of the way of WPF names; TrayIcon.cs refers to them explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icons, loaded at run time. Regenerate with tools\make-icons.ps1. -->
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

</Project>
