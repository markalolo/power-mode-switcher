<Window x:Class="PowerModeSwitcher.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Mode Switcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="Inter, Segoe UI">

    <!-- Layout and colors match the "Power Mode Switcher UI" design canvas. -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#D90F2F4C" />       <!-- navy at 85% -->
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#24FFFFFF" /> <!-- white at 14% -->
        <SolidColorBrush x:Key="TrackBrush" Color="#14FFFFFF" />       <!-- white at 8% -->
        <SolidColorBrush x:Key="DotBrush" Color="#4DFFFFFF" />         <!-- white at 30% -->

        <Style x:Key="ModeLabel" TargetType="Border">
            <Setter Property="Height" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="MouseLeftButtonDown" Handler="Label_MouseLeftButtonDown" />
            <EventSetter Event="MouseLeftButtonUp" Handler="Label_MouseLeftButtonUp" />
        </Style>

        <Style x:Key="ModeLabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <!-- Dragging anywhere on the background moves the widget. Right-click for the menu.
         The window is sized to this panel in code (ApplyLayout), at full or half size. -->
    <StackPanel x:Name="Root"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                MouseLeftButtonDown="Background_MouseLeftButtonDown"
                MouseMove="Background_MouseMove"
                MouseLeftButtonUp="Background_MouseLeftButtonUp"
                LostMouseCapture="Background_LostMouseCapture"
                MouseRightButtonUp="Background_MouseRightButtonUp">
        <StackPanel.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </StackPanel.LayoutTransform>

        <!-- Width is 230 with mode names, 128 without (set in ApplyLayout). -->
        <Border x:Name="Panel"
                Width="230" Height="340"
                CornerRadius="20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                Padding="19,19,5,19">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition x:Name="LabelGapColumn" Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Track with three stops. Knob centers sit at 50, 150 and 250. -->
                <Border x:Name="Track" Grid.Column="0"
                        Width="88" Height="300"
                        CornerRadius="44"
                        Background="{StaticResource TrackBrush}"
                        Cursor="Hand"
                        MouseLeftButtonDown="Track_MouseLeftButtonDown"
                        MouseMove="Track_MouseMove"
                        MouseLeftButtonUp="Track_MouseLeftButtonUp"
                        LostMouseCapture="Track_LostMouseCapture">
                    <Canvas>
                        <Ellipse Canvas.Left="41" Canvas.Top="47" Width="6" Height="6" Fill="{StaticResource DotBrush}" />
                        <Ellipse Canvas.Left="41" Canvas.Top="147" Width="6" Height="6" Fill="{StaticResource DotBrush}" />
                        <Ellipse Canvas.Left="41" Canvas.Top="247" Width="6" Height="6" Fill="{StaticResource DotBrush}" />

                        <Image x:Name="Knob"
                               Canvas.Left="4" Canvas.Top="110"
                               Width="80" Height="80"
                               Source="{StaticResource KnobBalanced}"
                               IsHitTestVisible="False">
                            <Image.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="10" ShadowDepth="4" Direction="270" />
                            </Image.Effect>
                        </Image>
                    </Canvas>
                </Border>

                <!-- Mode names, each centered on its stop. Can be turned off from the tray. -->
                <StackPanel x:Name="LabelsPanel" Grid.Column="2">
                    <Border Style="{StaticResource ModeLabel}" Tag="BestPerformance">
                        <TextBlock x:Name="PerformanceText" Style="{StaticResource ModeLabelText}" Text="Performance" />
                    </Border>
                    <Border Style="{StaticResource ModeLabel}" Tag="Balanced">
                        <TextBlock x:Name="BalancedText" Style="{StaticResource ModeLabelText}" Text="Balanced" />
                    </Border>
                    <Border Style="{StaticResource ModeLabel}" Tag="BestPowerEfficiency">
                        <TextBlock x:Name="BatteryText" Style="{StaticResource ModeLabelText}" Text="Battery" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Small status line under the widget: "Plugged in" / "On battery".
             Never wider than the panel; long text wraps onto a second line. -->
        <Border x:Name="StatusPill"
                Margin="0,8,0,0"
                MinHeight="26"
                Padding="12,4"
                HorizontalAlignment="Center"
                CornerRadius="13"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#D9FFFFFF" />
        </Border>
    </StackPanel>
</Window>
